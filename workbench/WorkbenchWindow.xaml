<Window x:Class="Cino.Workbench.WorkbenchWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="CINO-AOS · 原生工作台" Width="1340" Height="890" MinWidth="1080" MinHeight="720" WindowStartupLocation="CenterScreen"
    Background="#0A110D" Foreground="#EAF4ED" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13">
  <Window.Resources>
    <Style TargetType="ScrollBar"><Setter Property="Width" Value="8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
      <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
        <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
        <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#405D49" CornerRadius="4" Margin="1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
        <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
      </Track>
    </ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,10"/><Setter Property="Margin" Value="0,0,8,9"/><Setter Property="Foreground" Value="#DAEAE0"/><Setter Property="Background" Value="#1B3023"/><Setter Property="BorderBrush" Value="#385241"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#315641"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#A3F1BE"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox"><Setter Property="AcceptsReturn" Value="True"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="VerticalScrollBarVisibility" Value="Auto"/><Setter Property="Background" Value="#0B1510"/><Setter Property="Foreground" Value="#F1F9F3"/><Setter Property="CaretBrush" Value="#A3F1BE"/><Setter Property="BorderBrush" Value="#3B5946"/><Setter Property="Padding" Value="14"/><Setter Property="Margin" Value="0,0,0,12"/><Setter Property="FontSize" Value="14"/></Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#121F17"/><Setter Property="BorderBrush" Value="#2D4033"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="20"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
  </Window.Resources>
  <Grid Margin="24">
    <Grid.ColumnDefinitions><ColumnDefinition Width="188"/><ColumnDefinition Width="*"/><ColumnDefinition Width="253"/></Grid.ColumnDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,8,22,0">
      <TextBlock Text="CINO-AOS" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="NATIVE WORKSPACE" FontSize="10" Foreground="#88DEA8"/>
      <Border Height="1" Background="#304737" Margin="0,16,0,22"/>
      <TextBlock Text="工作台" FontSize="17"/><TextBlock Text="本地任务 · 真实成果" Foreground="#A9BEB0" FontSize="12"/>
      <Button Content="新建任务" Click="NewTask"/>
      <Button x:Name="InventoryButton" Content="生成文件清单" Click="InventoryClick"/>
      <Button Content="打开成果目录" Click="FolderClick"/>
      <Button x:Name="ManagementButton" Content="打开管理平台" Click="ManagementClick"/>
      <Border Height="1" Background="#304737" Margin="0,14,0,22"/>
      <TextBlock Text="本地智能" FontSize="14"/><TextBlock x:Name="ModelState" Text="模型尚未载入" Foreground="#A9BEB0"/>
      <Button x:Name="LoadButton" Content="启动模型" Click="LoadClick"/>
      <Button x:Name="ConfigureButton" Content="选择本地模型" Click="ConfigureClick"/>
      <TextBlock Text="模型内容可编辑。命令与脚本只作为文本保存。" Foreground="#91A899" FontSize="11"/>
      <Border Height="1" Background="#304737" Margin="0,14,0,20"/>
      <TextBlock x:Name="MachineScope" Foreground="#E2CA88" FontSize="12"/>
      <TextBlock Text="0.4.0 · 双机协作版" Foreground="#879E8F" FontSize="11"/>
    </StackPanel></ScrollViewer>
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="5,4,22,0">
      <TextBlock Text="YOUR LOCAL INTELLIGENCE" FontSize="10" Foreground="#88DEA8"/>
      <TextBlock Text="把想法，变成可用成果。" FontSize="28"/>
      <TextBlock Text="Windows 原生运行。内容在本机生成，成果存入本地目录。" FontSize="12" Foreground="#A9BEB0"/>
      <Border Style="{StaticResource Card}"><StackPanel>
        <TextBlock Text="01   描述任务" FontSize="16"/>
        <TextBlock Text="起草计划、整理要点、撰写说明。单次任务最多 1,800 字符。" FontSize="12" Foreground="#A9BEB0"/>
        <TextBox x:Name="TaskInput" Height="110" MaxLength="1800" AutomationProperties.Name="任务内容"/>
        <WrapPanel><Button Content="项目计划" Click="PlanExample"/><Button Content="整理说明" Click="DocumentExample"/></WrapPanel>
        <WrapPanel><Button x:Name="GenerateButton" Content="生成成果  →" Background="#2A6242" BorderBrush="#579C70" Click="GenerateClick"/><Button x:Name="CancelButton" Content="停止" IsEnabled="False" Click="CancelClick"/></WrapPanel>
        <ProgressBar x:Name="Progress" Height="3" IsIndeterminate="True" Visibility="Collapsed" Foreground="#91EDB4" Background="#1E3527" Margin="0,0,0,12"/>
        <TextBlock x:Name="ProgressText" Text="写下任务，生成一份可以继续编辑的成果。" Foreground="#A9BEB0"/>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel>
        <TextBlock Text="02   检查与保存" FontSize="16"/><TextBlock x:Name="ResultState" Text="等待你的第一个任务" FontSize="12" Foreground="#A9BEB0"/>
        <TextBox x:Name="ResultEditor" Height="185" AutomationProperties.Name="成果编辑器" TextChanged="ResultChanged"/>
        <WrapPanel><Button x:Name="SaveButton" Content="保存编辑副本" Click="SaveClick"/><Button x:Name="OpenButton" Content="记事本打开" Click="OpenClick"/></WrapPanel>
      </StackPanel></Border>
    </StackPanel></ScrollViewer>
    <DockPanel Grid.Column="2" Margin="0,4,0,0">
      <StackPanel DockPanel.Dock="Top"><TextBlock Text="任务与成果" FontSize="19"/><TextBlock Text="最近 100 条 · 重启后仍可查看" FontSize="11" Foreground="#A9BEB0"/></StackPanel>
      <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="16"><StackPanel>
        <TextBlock Text="设备连接"/><TextBlock x:Name="ServiceState" Text="正在读取设备状态…" Foreground="#A9BEB0" FontSize="12"/>
        <Button Content="刷新连接" Click="RefreshClick"/><Button Content="导出设备诊断" Click="DiagnosticsClick"/>
      </StackPanel></Border>
      <ListBox x:Name="HistoryList" Background="Transparent" BorderThickness="0" Foreground="#EAF4ED" HorizontalContentAlignment="Stretch" SelectionChanged="HistoryChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
    </DockPanel>
  </Grid>
</Window>
